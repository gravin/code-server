+
+// Expand brace alternatives before consuming directory segments. Braces inside
+// character classes are literals; alternatives can themselves contain '/'.
+function expandBraces(pattern: string): string[] {
+	let bracket = false;
+	let start = -1;
+	let depth = 0;
+	for (let i = 0; i < pattern.length; i++) {
+		const character = pattern[i];
+		if (character === '[') { bracket = true; }
+		if (character === ']') { bracket = false; }
+		if (bracket) { continue; }
+		if (character === '{') { if (!depth++) { start = i; } }
+		if (character === '}' && depth && !--depth) {
+			return glob.splitGlobAware(pattern.slice(start + 1, i), ',').flatMap(part => expandBraces(pattern.slice(0, start) + part + pattern.slice(i + 1)));
