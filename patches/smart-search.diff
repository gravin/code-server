+// Intersect a user glob with a whole project subtree, without listing files.
+// Walk the literal project prefix through a glob's segment states; '**' can
+// consume zero or more segments. The remaining suffixes stay as provider globs.
+function subtreePatterns(prefix: string, expression: glob.IExpression | undefined, ignoreCase: boolean): string[] {
+	const literal = literalGlob(prefix);
+	if (!expression) { return [prefix ? `${literal}/**` : '**']; }
