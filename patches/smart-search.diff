+export function getSmartSearchScope(configuration: IConfigurationService, workspace: IWorkspaceContextService): ISmartSearchScope | undefined {
+	const snapshot = configuration.getValue<Omit<ISmartSearchScope, 'root'> & { root?: string }>('elevator.smartWorkspace');
+	const root = workspace.getWorkspace().folders.find(folder => folder.uri.path === snapshot?.root)?.uri;
+	if (!root || (!Array.isArray(snapshot.projectRoots) && !Array.isArray(snapshot.files))) { return undefined; }
+	const cached = scopes.get(snapshot);
+	if (cached && cached.root.toString() === root.toString()) { return cached; }
+	const scope = { ...snapshot, root };
+	scopes.set(snapshot, scope);
+	return scope;
+}
+
+function scopeIndex(scope: ISmartSearchScope): IScopeIndex {
+	let index = indexes.get(scope);
+	if (index) { return index; }
+	index = { projects: new Set(), notebooks: new Set(), ancestors: new Set(['']), skipped: new Set(scope.skipDirectories?.map(name => name.toLowerCase())), files: new Set(scope.files), directories: new Set(scope.directories) };
+	const addAncestors = (relative: string) => {
+		const parts = relative.split('/');
+		for (let i = 1; i < parts.length; i++) { index!.ancestors.add(parts.slice(0, i).join('/')); }
+	};
+	for (const path of scope.projectRoots ?? []) {
+		const resource = scope.root.with({ path });
+		if (!isEqualOrParent(resource, scope.root)) { continue; }
+		const relative = relativePath(scope.root, resource)!;
+		index.projects.add(relative);
+		index.ancestors.add(relative);
+		addAncestors(relative);
+	}
+	for (const path of scope.notebooks ?? []) {
+		const resource = scope.root.with({ path });
+		if (!isEqualOrParent(resource, scope.root)) { continue; }
+		const relative = relativePath(scope.root, resource)!;
+		index.notebooks.add(relative);
+		addAncestors(relative);
+	}
+	indexes.set(scope, index);
+	return index;
+}
