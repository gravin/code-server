+// Explorer, open editors, Ctrl+P and every search result use this same rule.
+export function isSmartSearchResourceAllowed(scope: ISmartSearchScope | undefined, resource: URI, isDirectory = false): boolean {
+	if (!scope) { return true; }
+	if (!isEqualOrParent(resource, scope.root)) { return false; }
+	const relative = relativePath(scope.root, resource)!;
+	const index = scopeIndex(scope);
+	const parts = relative ? relative.split('/') : [];
+	const directoryParts = isDirectory ? parts : parts.slice(0, -1);
+	if (directoryParts.some(part => index.skipped.has(part.toLowerCase()))) { return false; }
+	if (scope.projectRoots) {
+		if (isDirectory && index.ancestors.has(relative)) { return true; }
+		if (!isDirectory && index.notebooks.has(relative)) { return true; }
+		for (let i = 0; i <= directoryParts.length; i++) {
+			if (index.projects.has(directoryParts.slice(0, i).join('/'))) { return true; }
+		}
