+export interface ISmartSearchScope {
+	root: URI;
+	projectRoots?: string[];
+	notebooks?: string[];
+	skipDirectories?: string[];
+	// Read old snapshots until Refresh Explorer replaces them with version 2.
+	files?: string[];
+	directories?: string[];
