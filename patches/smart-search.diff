+			const closure = (states: Set<number>) => {
+				for (const state of states) { if (segments[state] === '**') { states.add(state + 1); } }
+				return states;
+			};
+			let states = closure(new Set([0]));
+			for (const part of prefix ? prefix.split('/') : []) {
