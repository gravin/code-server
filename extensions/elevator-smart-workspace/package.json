{
  "name": "smart-workspace",
  "displayName": "Elevator Smart Workspace",
  "description": "Scan a course directory and open its code projects in a hierarchical multi-root workspace.",
  "publisher": "elevator",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:elevator.openFolderSmartly",
    "onCommand:elevator.refreshSmartWorkspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "elevator.openFolderSmartly",
        "title": "Open Folder Smartly...",
        "category": "File"
      },
      {
        "command": "elevator.refreshSmartWorkspace",
        "title": "Rescan Smart Workspace",
        "category": "File"
      }
    ],
    "configuration": {
      "title": "Elevator Smart Workspace",
      "properties": {
        "elevator.smartWorkspace": {
          "type": "object",
          "scope": "window",
          "default": {},
          "description": "Generated scan snapshot for the code-server hierarchical Explorer. Run Open Folder Smartly to regenerate.",
          "properties": {
            "root": {
              "type": "string"
            },
            "version": {
              "type": "number"
            },
            "projectRoots": {
              "type": "array",
              "description": "Absolute code project roots; all contents are visible except skipped directories.",
              "items": {
                "type": "string"
              }
            },
            "notebooks": {
              "type": "array",
              "description": "Absolute paths of standalone notebooks outside code project roots.",
              "items": {
                "type": "string"
              }
            },
            "skipDirectories": {
              "type": "array",
              "description": "Directory names excluded from discovery, Explorer and Smart search.",
              "items": {
                "type": "string"
              }
            },
            "directories": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "scannedAt": {
              "type": "string"
            }
          }
        }
      }
    },
    "configurationDefaults": {
      "python.languageServer": "None"
    }
  }
}
